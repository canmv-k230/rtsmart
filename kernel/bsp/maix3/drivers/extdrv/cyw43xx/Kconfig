menuconfig RT_USING_CYW43XX
    bool "CYW43xx SDIO Wi-Fi"
    depends on RT_USING_WIFI && RT_USING_SDIO
    default n
    help
        Enable the CYW43xx SDIO Wi-Fi driver. It may be built together with
        other SDIO Wi-Fi drivers; the SDIO manufacturer and product IDs
        select the driver at runtime.

    if RT_USING_CYW43XX
        menu "Thread Settings"

            config CYW43XX_THREAD_PRIORITY
                int "Thread priority"
                default 10

            config CYW43XX_THREAD_STACK_SIZE
                int "Thread stack size"
                default 4096

        endmenu
    endif
