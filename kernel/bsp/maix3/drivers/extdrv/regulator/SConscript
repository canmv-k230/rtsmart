# RT-Thread building script for component

from building import *

cwd     = GetCurrentDir()
src     = []
CPPPATH = [cwd]

# regulator.h stays on the include path: without RT_USING_REGULATOR it
# provides stubs, so consumers need no conditional includes.
if GetDepend(['RT_USING_REGULATOR']):
    src += Glob('regulator.c')

    if GetDepend(['RT_USING_REGULATOR_TPS6286X']):
        src += Glob('tps6286x.c')

    if GetDepend(['RT_USING_REGULATOR_GPIO']):
        src += Glob('regulator_gpio.c')

    if GetDepend(['RT_USING_REGULATOR_K230_IOBANK']):
        src += Glob('regulator_k230_iobank.c')

group = DefineGroup('REGULATOR', src, depend = [''], CPPPATH = CPPPATH)

objs = [group]

list = os.listdir(cwd)

for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        objs = objs + SConscript(os.path.join(item, 'SConscript'))

Return('objs')
