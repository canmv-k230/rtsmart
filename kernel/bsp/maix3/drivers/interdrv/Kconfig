                config RT_SDIO0_UHS
                    bool "Enable SDIO0 SD UHS-I (1.8V signaling)"
                    depends on !RT_SDIO0_EMMC && !RT_SDIO0_1V8 && RT_USING_REGULATOR
                    default n
                    help
                        Needs hardware that switches the I/O bank supply between
                        3.3 V and 1.8 V, described as a board regulator. Modes
                        follow the controller: SDR104 needs the 200 MHz clock and
                        the tuning PHY. A card power switch is strongly advised:
                        a card left at 1.8 V survives a warm reset.

                config RT_SDIO0_VQMMC
                    string "SDIO0 I/O supply regulator"
                    depends on RT_SDIO0_UHS
                    default "sd0_vqmmc"

                config RT_SDIO0_VMMC
                    string "SDIO0 card power regulator (empty: none)"
                    depends on RT_SDIO0_UHS
                    default ""
            endif

            config RT_USING_SDIO1
                bool "Enable SDIO1"
                default n

            config RT_SDIO1_UHS
                bool "Enable SDIO1 SD UHS-I (1.8V signaling)"
                depends on RT_USING_SDIO1 && RT_USING_REGULATOR
                default n
                help
                    Needs hardware that switches the I/O bank supply between
                    3.3 V and 1.8 V, described as a board regulator. SDIO1 has
                    a 100 MHz clock and no tuning PHY: at most DDR50, or SDR50
                    where the controller does not require tuning for it. A card
                    power switch is strongly advised: a card left at 1.8 V
                    survives a warm reset.

            config RT_SDIO1_VQMMC
                string "SDIO1 I/O supply regulator"
                depends on RT_SDIO1_UHS
                default "sd1_vqmmc"

            config RT_SDIO1_VMMC
                string "SDIO1 card power regulator (empty: none)"
                depends on RT_SDIO1_UHS
                default ""

            config RT_SDIO_SKIP_INITIAL_PROBE
                bool "Skip SDIO probing on the first boot-storage scan"
                depends on RT_USING_SDIO0 || RT_USING_SDIO1
                default y
                help
                    The boot SD/MMC controller on supported boards is used for storage.
                    Skip SDIO CMD52 reset, its settle delay and CMD5 probing on its
                    first scan. Later scans use normal probing, even if the first fails.
                    SD/MMC power-up, identification and retry timings are unchanged.
                    Other hosts, including SDIO Wi-Fi, retain normal enumeration.
                    This setting is independent of fast boot. Disable it when using
                    an SDIO combo card on the boot host.

            config BSP_SDIO_CARD_MAX_SEG_SIZE_KB
                int "SD/SDIO maximum segment size (KiB)"
                depends on RT_USING_SDIO1 || (RT_USING_SDIO0 && !RT_SDIO0_EMMC)
                default 256
                range 1 2048
                help
                    Maximum amount of data submitted in one SD/SDIO request.
                    The SDHCI driver allocates an equally sized persistent SDMA
                    bounce buffer for every non-eMMC host.

            config BSP_SDIO_EMMC_MAX_SEG_SIZE_KB
                int "eMMC maximum segment size (KiB)"
                depends on RT_USING_SDIO0 && RT_SDIO0_EMMC
                default 1024
                range 1 2048
                help
                    Maximum amount of data submitted in one eMMC request. The
                    SDHCI driver allocates an equally sized persistent SDMA
                    bounce buffer for the eMMC host.

            config BSP_SDIO_STORAGE_WRITE_TIMEOUT_MS
                int "SD/MMC storage write request watchdog (ms)"
                default 5000
                range 1000 120000
                help
                    Software watchdog applied to a complete write request for
                    SD, MMC/eMMC, and SDIO combo storage. Slow managed-flash
                    storage can occasionally spend seconds doing internal
                    garbage collection during metadata-heavy workloads. This
                    watchdog is independent of the controller instance and is
                    separate from the controller data timeout.

            config BSP_SDIO_IO_WRITE_TIMEOUT_MS
                int "SDIO device write request watchdog (ms)"
                default 1000
                range 1000 120000
                help
                    Software watchdog applied to a complete SDIO CMD53 write
                    request, including I/O functions on SDIO combo cards. This
                    setting is independent of the controller instance.

            config RT_SDIO_ENABLE_REPROBE_CMD
